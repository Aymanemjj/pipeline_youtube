# ============================
# Airflow core configuration
# ============================
AIRFLOW_UID=50000                        # Host UID for file permissions (Linux only, usually 50000)
FERNET_KEY=                              # Used to encrypt connection passwords in the metadata DB
                                          # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_WWW_USER_USERNAME=admin          # Username for the Airflow webserver login
AIRFLOW_WWW_USER_PASSWORD=               # Password for the Airflow webserver login

# ============================
# YouTube Data API credentials
# ============================
BASE_URL=https://www.googleapis.com/youtube/v3   # YouTube Data API base endpoint
API_KEY=                                          # Your YouTube Data API v3 key (Google Cloud Console)
CHANNEL_HANDLE=                                   # Target channel's handle, e.g. "SomeChannelName" (no @)

# ============================
# Postgres connection (used by Airflow to talk to your app DB)
# ============================
POSTGRES_CONN_HOST=postgres              # Docker service name of the Postgres container
POSTGRES_CONN_PORT=5432                  # Default Postgres port
POSTGRES_CONN_USERNAME=                  # DB user Airflow connects as
POSTGRES_CONN_PASSWORD=                  # DB password for the above user

# ============================
# Airflow metadata database (stores DAG runs, task state, etc.)
# ============================
METADATA_DATABASE_USERNAME=
METADATA_DATABASE_PASSWORD=
METADATA_DATABASE_NAME=airflow_metadata

# ============================
# Celery result backend (used by CeleryExecutor for task queueing)
# ============================
CELERY_BACKEND_USERNAME=
CELERY_BACKEND_PASSWORD=
CELERY_BACKEND_NAME=airflow_celery

# ============================
# ELT target database (your actual pipeline data: staging + core tables)
# ============================
ELT_DATABASE_USERNAME=
ELT_DATABASE_PASSWORD=
ELT_DATABASE_NAME=youtube_elt